generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  CONTENT_EDITOR
}

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  role             AdminRole
  mfaSecret        String?
  mfaEnabled       Boolean   @default(false)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions  AdminSession[]
  auditLogs AuditLog[]
}

model AdminSession {
  id          String   @id @default(cuid())
  adminUserId String
  tokenHash   String   @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

enum ContentPageSlug {
  ABOUT
  CONTACT
  TERMS
  PRIVACY
  REFUND_POLICY
  DISCLAIMER
}

model ContentPage {
  id              String          @id @default(cuid())
  slug            ContentPageSlug @unique
  title           String
  body            String
  metaDescription String?
  published       Boolean         @default(true)
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())
}

model HomepageContent {
  id                 String   @id @default(cuid())
  heroHeading        String
  heroSubheading     String
  heroCtaLabel       String
  heroCtaHref        String
  missionHeading     String
  missionBody        String
  finalCtaHeading    String
  finalCtaBody       String
  finalCtaLabel      String
  finalCtaHref       String
  footerAboutText    String
  footerContactEmail String
  footerContactPhone String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model EducationalFocusItem {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model Instructor {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  credentials String?
  shortBio    String
  fullBio     String
  photoUrl    String?
  websiteUrl  String?
  socialLinks Json?
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events EventInstructor[]

  @@index([published, sortOrder])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

enum EventStatus {
  DRAFT
  COMING_SOON
  PUBLISHED
  ON_SALE
  SOLD_OUT
  CLOSED
  CANCELLED
  COMPLETED
}

model Location {
  id         String   @id @default(cuid())
  name       String
  address    String
  city       String
  state      String
  postalCode String?
  country    String   @default("US")
  latitude   Float?
  longitude  Float?
  mapUrl     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events Event[]

  @@index([city, state])
}

model Event {
  id                 String      @id @default(cuid())
  slug               String      @unique
  title              String
  seriesName         String?
  volumeLabel        String?
  internalCode       String?
  shortDescription   String
  longDescription    String?
  startAt            DateTime
  endAt              DateTime?
  timezone           String
  city               String
  state              String
  locationId         String?
  coverImageUrl      String?
  galleryImageUrls   String[]    @default([])
  documentUrls       String[]    @default([])
  whatYouWillLearn   String[]    @default([])
  materialsIncluded  String[]    @default([])
  prerequisites      String?
  disclaimer         String?
  seoTitle           String?
  seoMetaDescription String?
  seoCanonicalUrl    String?
  seoOgImageUrl      String?
  status             EventStatus @default(DRAFT)
  isFeatured         Boolean     @default(false)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  location     Location?          @relation(fields: [locationId], references: [id])
  instructors  EventInstructor[]
  ticketTypes  EventTicketType[]
  faqOverrides EventFaqOverride[]

  @@index([status, isFeatured, sortOrder])
  @@index([locationId])
}

model EventInstructor {
  id           String   @id @default(cuid())
  eventId      String
  instructorId String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([eventId, instructorId])
  @@index([instructorId])
}

model EventTicketType {
  id              String    @id @default(cuid())
  eventId         String
  name            String
  priceMinorUnits Int
  currency        String    @default("USD")
  capacity        Int
  salesStartAt    DateTime?
  salesEndAt      DateTime?
  refundPolicy    String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventFaqOverride {
  id        String   @id @default(cuid())
  eventId   String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
}
