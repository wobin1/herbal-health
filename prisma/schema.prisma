generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  CONTENT_EDITOR
}

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  role             AdminRole
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions   AdminSession[]
  auditLogs  AuditLog[]
  loginCodes AdminLoginCode[]
}

/// Emailed one-time code for the second login factor. Only a keyed hash is
/// stored; at most one outstanding code per admin (issuing a new one deletes
/// the old). Needed to verify the code server-side without persisting it.
model AdminLoginCode {
  id          String    @id @default(cuid())
  adminUserId String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

/// Emailed invitation to create an admin account. The raw token only ever
/// lives in the email link; only its SHA-256 hash is stored. Single-use
/// (consumedAt) and expiring (expiresAt). No FK to AdminUser: the account
/// doesn't exist until the invite is accepted. The inviter is recorded in the
/// audit log, not here.
model AdminInvite {
  id         String    @id @default(cuid())
  email      String
  role       AdminRole
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model AdminSession {
  id          String   @id @default(cuid())
  adminUserId String
  tokenHash   String   @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

enum ContentPageSlug {
  ABOUT
  CONTACT
  TERMS
  PRIVACY
  REFUND_POLICY
  DISCLAIMER
}

model ContentPage {
  id              String          @id @default(cuid())
  slug            ContentPageSlug @unique
  title           String
  body            String
  metaDescription String?
  published       Boolean         @default(true)
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())
}

model HomepageContent {
  id                 String   @id @default(cuid())
  heroHeading        String
  heroSubheading     String
  heroCtaLabel       String
  heroCtaHref        String
  missionHeading     String
  missionBody        String
  finalCtaHeading    String
  finalCtaBody       String
  finalCtaLabel      String
  finalCtaHref       String
  footerAboutText    String
  footerContactEmail String
  footerContactPhone String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  ipAddress String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model EducationalFocusItem {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  imageUrl    String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model Instructor {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  credentials String?
  shortBio    String
  fullBio     String
  photoUrl    String?
  websiteUrl  String?
  socialLinks Json?
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events EventInstructor[]

  @@index([published, sortOrder])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

enum EventStatus {
  DRAFT
  COMING_SOON
  PUBLISHED
  ON_SALE
  SOLD_OUT
  CLOSED
  CANCELLED
  COMPLETED
}

model Location {
  id         String   @id @default(cuid())
  name       String
  address    String
  city       String
  state      String
  postalCode String?
  country    String   @default("US")
  latitude   Float?
  longitude  Float?
  mapUrl     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events Event[]

  @@index([city, state])
}

model Event {
  id                 String      @id @default(cuid())
  slug               String      @unique
  title              String
  seriesName         String?
  volumeLabel        String?
  internalCode       String?
  shortDescription   String
  longDescription    String?
  startAt            DateTime
  endAt              DateTime?
  timezone           String
  city               String
  state              String
  locationId         String?
  coverImageUrl      String?
  galleryImageUrls   String[]    @default([])
  documentUrls       String[]    @default([])
  whatYouWillLearn   String[]    @default([])
  materialsIncluded  String[]    @default([])
  prerequisites      String?
  disclaimer         String?
  seoTitle           String?
  seoMetaDescription String?
  seoCanonicalUrl    String?
  seoOgImageUrl      String?
  status             EventStatus @default(DRAFT)
  isFeatured         Boolean     @default(false)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  location      Location?          @relation(fields: [locationId], references: [id])
  instructors   EventInstructor[]
  ticketTypes   EventTicketType[]
  faqOverrides  EventFaqOverride[]
  orders        Order[]
  registrations Registration[]

  @@index([status, isFeatured, sortOrder])
  @@index([locationId])
}

model EventInstructor {
  id           String   @id @default(cuid())
  eventId      String
  instructorId String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([eventId, instructorId])
  @@index([instructorId])
}

model EventTicketType {
  id              String    @id @default(cuid())
  eventId         String
  name            String
  priceMinorUnits Int
  currency        String    @default("USD")
  capacity        Int
  reservedCount   Int       @default(0)
  soldCount       Int       @default(0)
  salesStartAt    DateTime?
  salesEndAt      DateTime?
  refundPolicy    String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([eventId])
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

model Order {
  id                      String      @id @default(cuid())
  eventId                 String
  status                  OrderStatus @default(PENDING)
  totalMinorUnits         Int
  currency                String      @default("USD")
  buyerEmail              String
  buyerName               String
  buyerPhone              String
  buyerCountry            String
  reservationExpiresAt    DateTime?
  stripeCheckoutSessionId String?     @unique
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  event           Event                        @relation(fields: [eventId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  attendees       Attendee[]
  registrations   Registration[]
  termAcceptances RegistrationTermAcceptance[]

  @@index([eventId])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  eventTicketTypeId   String
  quantity            Int
  unitPriceMinorUnits Int
  subtotalMinorUnits  Int
  createdAt           DateTime @default(now())

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventTicketType EventTicketType @relation(fields: [eventTicketTypeId], references: [id])
  attendees       Attendee[]
  registrations   Registration[]

  @@index([orderId])
  @@index([eventTicketTypeId])
}

model Attendee {
  id                 String    @id @default(cuid())
  orderId            String
  orderItemId        String
  firstName          String
  lastName           String
  email              String
  phone              String
  country            String
  internalNotes      String?
  attendedAt         DateTime?
  createdAt          DateTime  @default(now())

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  registration Registration?

  @@index([orderId])
  @@index([orderItemId])
}

model Registration {
  id          String             @id @default(cuid())
  reference   String             @unique
  orderId     String
  orderItemId String
  attendeeId  String             @unique
  eventId     String
  status      RegistrationStatus @default(CONFIRMED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  attendee  Attendee  @relation(fields: [attendeeId], references: [id])
  event     Event     @relation(fields: [eventId], references: [id])

  @@index([orderId])
  @@index([eventId])
}

model RegistrationTermAcceptance {
  id           String   @id @default(cuid())
  orderId      String
  termsVersion String
  acceptedAt   DateTime @default(now())
  ipAddress    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("stripe")
  providerPaymentId String?
  providerEventId   String        @unique
  status            PaymentStatus @default(PENDING)
  amountMinorUnits  Int
  currency          String        @default("USD")
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model EventFaqOverride {
  id        String   @id @default(cuid())
  eventId   String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
}

enum EmailType {
  REGISTRATION_CONFIRMATION
  PAYMENT_RECEIPT
  PAYMENT_FAILURE
  EVENT_REMINDER
  EVENT_UPDATE
  EVENT_CANCELLATION
  REGISTRATION_CANCELLATION
  REFUND_CONFIRMATION
  REGISTRATION_TRANSFER
  ADMIN_NEW_REGISTRATION
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/**
 * Outbound email outbox: writing a row here (instead of calling the
 * provider inline) is what lets a payment/refund/registration transaction
 * commit even if email delivery is slow or failing. A separate job drains
 * PENDING rows and retries FAILED-but-not-exhausted ones. `dedupeKey` is the
 * idempotency gate — reminder jobs and at-least-once retries key off it so a
 * duplicate enqueue never sends the same email twice.
 */
model EmailMessage {
  id        String      @id @default(cuid())
  type      EmailType
  toEmail   String
  dedupeKey String      @unique
  variables Json
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
}
