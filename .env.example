DATABASE_URL=
DIRECT_URL=

AUTH_SECRET=

# Dev-only: accept this fixed code in place of a real TOTP code at the MFA step, so admin
# login doesn't require an authenticator app during local development. Ignored when
# NODE_ENV=production, regardless of whether this var is set — never use in staging/prod.
DEV_MFA_BYPASS_CODE=

NEXT_PUBLIC_SITE_URL=

# Payment provider: Stripe Checkout (cards, Apple Pay, Google Pay, PayPal).
# PAYMENT_PROVIDER=stripe
# PAYMENT_SECRET_KEY=sk_test_...   (Stripe secret key)
# PAYMENT_WEBHOOK_SECRET=whsec_... (Stripe webhook signing secret, from `stripe listen` or the Dashboard)
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Transactional email provider: Resend (https://resend.com).
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_...
# EMAIL_FROM="Herbal Health Seminars <noreply@example.com>"
# Left unset in dev/test: emails are enqueued but never actually sent.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Recipient for the "new registration" admin notification email. Leave unset to skip it.
ADMIN_NOTIFICATION_EMAIL=

# Image uploads (admin gallery, event media, education focus items): Cloudinary
# (https://cloudinary.com). Find these on the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CRON_SECRET=
